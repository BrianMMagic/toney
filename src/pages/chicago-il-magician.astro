---
import LocationPageContent from '../components/LocationPageContent.astro';
import { generalLocationFaqs } from '../data/faqs';
import type { Testimonial } from '../data/testimonials';

// Chicago-specific testimonials — verbatim from source
const chicagoTestimonials: Testimonial[] = [
  {
    quote:
      "Every person in the room got to experience his skills and every single person was amazed! The attendees are STILL talking about the things he showed us. I usually am a bit skeptical of people performing magic and mind tricks, but Anthony made me a believer. I still have no idea how he knew what I was thinking, but I was very glad that we hired him. He was as funny as he was entertaining!",
    name: 'Randall S.',
    company: 'Nissan',
    image: 'https://static.wixstatic.com/media/40084f_f3facf82d8194a2799b7851dab1cc03a~mv2.png/v1/fill/w_225,h_290,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/40084f_f3facf82d8194a2799b7851dab1cc03a~mv2.png',
  },
  {
    quote:
      "Anthony was an absolute hit at my corporate event. I needed quality entertainment as I had a venue full of valued clients I wanted to impress. Anthony did an awesome job of \"reading\" the guests' conversations and approaching at the perfect time. He actually surprised a lot of people because he blended in so professionally! My clients loved him and appreciated unique entertainment and opposed to shouting over DJ or band. Will absolutely be using Anthony for future events.",
    name: 'Virginia B.',
    company: 'Expedia',
    image: 'https://static.wixstatic.com/media/40084f_424e0e7cec044da5ae1f188307224f2a~mv2.png/v1/fill/w_225,h_290,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/40084f_424e0e7cec044da5ae1f188307224f2a~mv2.png',
  },
  {
    quote:
      "Anthony performed at one of our recent company hosted dinner events and I was absolutely blown away. The moment he walked in and started talking to people, all of those pre-conceived notions you might have had about magic being cheesy immediately disappeared. Anthony was absolutely enthralling. He is exceptionally talented and you feel like you get so much more value out of his show vs. what you see at other corporate events. We will 100% be bringing him back. 5 stars for sure.",
    name: 'William R.',
    company: 'Eagle Materials',
    image: 'https://static.wixstatic.com/media/40084f_6f9c3ba5150748f9b631b39ac01dc127~mv2.png/v1/fill/w_225,h_290,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/6.png',
  },
];
---

<LocationPageContent
  pageTitle="Chicago Magician | Corporate Event Entertainment"
  metaDescription="Kick your event up a notch. Anthony Dempsey's extensive experience makes him Chicago's ideal choice for corporate and private events. Experience magic and mentalism that is beyond belief."
  canonicalUrl="https://anthonyentertains.com/chicago-il-magician"
  heroEyebrow="Chicago Magician & Mentalist"
  heroHeadline="Mind-Blowing Magic &amp; Mentalism<br>In Chicago, IL"
  heroSubheadline="Reach Out Today To Find Out How Anthony Can Transform Your Chicago Corporate Event Or Private Party Into An Unforgettable Experience."
  intro="Making boring events a thing of the past!"
  corporateBody="The entertainment you hire is a reflection of your company. Hiring Anthony Dempsey as your magician and mentalist will show your guests that you value the experience they have at your event. Whether it's strolling magic during a casual cocktail hour or a full mentalism stage show during a large sales meeting, Anthony will use his communication skills to connect your employees, help them build new friendships, and create a stronger team. His high-impact, interactive entertainment combined with his quick wit make Anthony the best performing magician in Chicago. Anthony has successfully executed over 2,000 corporate events, many of which were for Fortune 500 clients. His expertise and track record makes him the ideal choice for corporate entertainment in Chicago as well as nationwide."
  privateBody="Want to throw a party in Chicago that people will be talking about for years to come? Look no further! Anthony is here to bring unforgettable entertainment to your event. Whether it's jaw-dropping magic tricks performed right before your eyes or a mind-bending mentalism act, Anthony will ensure your guests are blown away. And if you're looking for something on a grander scale, he can even put on a full-stage show in your living room! Give your party the wow factor it deserves with Anthony as your entertainer."
  stageHeading="Stage Shows & MC Service"
  stageBody="Anthony's Magic & Mind Reading Stage Show will put your guests and company in the spotlight. This fully customizable show guarantees an unforgettable experience where audience participation is used from start to finish. Anthony's comedy magic & mentalism stage show is great for large-scale events, product launches, fundraiser galas, holiday parties, and as a break from symposium sessions. Anthony's extensive experience as a stage actor has also contributed to his successful career as an event MC. He'll be the friendly face that will guide your guests throughout their evening, salt and peppering in his sought-after magic and mentalism."
  servingAreas="Serving the <a href='https://www.chicago.gov/city/en.html' target='_blank' rel='noopener noreferrer'>Chicago Area</a> — <a href='https://www.choosechicago.com/neighborhoods/lincoln-park/' target='_blank' rel='noopener noreferrer'>Lincoln Park</a>, <a href='https://www.villageofschaumburg.com/' target='_blank' rel='noopener noreferrer'>Schaumburg</a>, <a href='https://www.villageofglencoe.org/' target='_blank' rel='noopener noreferrer'>Glencoe</a>, <a href='https://www.villageofwinnetka.org/' target='_blank' rel='noopener noreferrer'>Winnetka</a>, <a href='https://www.oak-brook.org/' target='_blank' rel='noopener noreferrer'>Oak Brook</a>, <a href='https://www.vok.org/' target='_blank' rel='noopener noreferrer'>Kenilworth</a>, <a href='https://www.naperville.il.us/' target='_blank' rel='noopener noreferrer'>Naperville</a>, &amp; more."
  faqs={generalLocationFaqs('Chicago', 'IL')}
  guaranteesLabel="Unlock the Secrets of a Truly Memorable Event"
  testimonialsTitle="Clients Who Love Anthony's Chicago, IL Entertainment"
  testimonials={chicagoTestimonials}
/>

