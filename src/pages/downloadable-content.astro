---

<BaseLayout
  title="Downloadable Material | anthonyentertains"
  description="This page contains promotional photos, posters, and flyers for clients to use when promoting their events."
  canonicalUrl="https://anthonyentertains.com/downloadable-content"
>
  <!-- Hero -->
  <Hero
    headline="Downloadable Material"
    subheadline={`Hover over the desired item and click the "download" icon.`}
    bgImage="https://static.wixstatic.com/media/40084f_ef998d763cf64f06b5cda2c8a7d3dee7~mv2.jpg/v1/fill/w_1280,h_720,al_t,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/40084f_ef998d763cf64f06b5cda2c8a7d3dee7~mv2.jpg"
    overlay="rgba(0,0,0,0.65)"
    minHeight="45vh"
  />

  <!-- Downloads Section -->
  <section class="section">
    <div class="container">
      <div class="downloads-grid" data-reveal-stagger>
        {downloadables.map((item) => (
          <div class="download-card">
            <div class="download-thumb">
              <img src={item.thumb} alt={item.title} loading="lazy" width="227" height="226" />
              <a
                href={item.full}
                class="download-overlay"
                download
                aria-label={`Download ${item.title}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
              </a>
            </div>
            <h3 class="download-title">{item.title}</h3>
            <a
              href={item.full}
              class="download-btn"
              download
              aria-label={`Download ${item.title}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Download
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Short Bio Section -->
  <section class="section section--dark bio-section">
    <div class="container">
      <h2 class="section-title" data-reveal="fade-up">Short Bio</h2>
      <div class="divider" data-reveal="fade-up"></div>
      <p class="section-sub" data-reveal="fade-up">Just copy and paste the paragraph below if a bio is needed.</p>

      <div class="bio-box" data-reveal="fade-up">
        <blockquote class="bio-text">
          Award-winning comedy magician and mentalist Anthony Dempsey has thrilled corporate and celebrity audiences across the globe. Anthony has been seen by millions of people on film and television; most recently appearing on Penn and Teller&#8217;s Fool Us!
        </blockquote>
        <button class="btn btn--outline copy-btn" onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent.trim()).then(() => { this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy to Clipboard', 2000); })">
          Copy to Clipboard
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.downloads-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.download-card {
  background: var(--c-card-bg);
  border: 1px solid var(--c-card-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 0 0 20px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  overflow: hidden;
  transition:
    background   var(--transition-fast),
    transform    0.3s var(--ease-out-quint),
    box-shadow   0.3s var(--ease-out-quint);
}
@media (hover: hover) {
  .download-card:hover {
    background: var(--c-card-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
}

.download-thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: #ddd;
}

.download-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.download-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  opacity: 0;
  transition: opacity 0.2s ease;
  text-decoration: none;
}
.download-thumb:hover .download-overlay {
  opacity: 1;
}

.download-title {
  font-size: 0.9rem;
  color: var(--c-dark-base);
  font-weight: 500;
  padding: 0 12px;
}

.download-btn {
  display: inline-block;
  background: transparent;
  border: 1.5px solid rgba(20, 21, 29, 0.25);
  padding: 6px 18px;
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--c-dark-muted);
  text-decoration: none;
  transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
}
.download-btn:hover {
  background: var(--c-brand-navy);
  color: var(--c-light-base);
  border-color: var(--c-brand-navy);
}

.bio-box {
  max-width: 720px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.bio-text {
  font-size: 1rem;
  color: var(--c-dark-muted);
  line-height: 1.85;
  border-left: 2px solid rgba(20, 21, 29, 0.2);
  padding-left: 24px;
  margin: 0;
  font-style: italic;
  max-width: none;
}

.copy-btn { align-self: flex-start; }

@media (max-width: 1024px) {
  .downloads-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 640px) {
  .downloads-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 400px) {
  .downloads-grid { grid-template-columns: 1fr; }
}
</style>
