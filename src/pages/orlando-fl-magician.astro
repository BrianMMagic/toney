---
import LocationPageContent from '../components/LocationPageContent.astro';
import type { Testimonial } from '../data/testimonials';
import type { FAQ } from '../data/faqs';

// ── Orlando-specific testimonials (verbatim from source) ──────────────────────
const orlandoTestimonials: Testimonial[] = [
  {
    quote:
      "Every person in the room got to experience his skills and every single person was amazed! The attendees are STILL talking about the things he showed us. I usually am a bit skeptical of people performing magic and mind tricks, but Anthony made me a believer. I still have no idea how he knew what I was thinking, but I was very glad that we hired him. He was as funny as he was entertaining!",
    name: "Randall S.",
    company: "Nissan",
    image:
      "https://static.wixstatic.com/media/40084f_f3facf82d8194a2799b7851dab1cc03a~mv2.png/v1/fill/w_225,h_290,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/40084f_f3facf82d8194a2799b7851dab1cc03a~mv2.png",
  },
  {
    quote:
      "Anthony was an absolute hit at my corporate event. I needed quality entertainment as I had a venue full of valued clients I wanted to impress. Anthony did an awesome job of 'reading' the guests' conversations and approaching at the perfect time. He actually surprised a lot of people because he blended in so professionally! My clients loved him and appreciated unique entertainment and opposed to shouting over DJ or band. Will absolutely be using Anthony for future events.",
    name: "Virginia B.",
    company: "Expedia",
    image:
      "https://static.wixstatic.com/media/40084f_424e0e7cec044da5ae1f188307224f2a~mv2.png/v1/fill/w_225,h_290,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/40084f_424e0e7cec044da5ae1f188307224f2a~mv2.png",
  },
  {
    quote:
      "Anthony performed at one of our recent company hosted dinner events and I was absolutely blown away. The moment he walked in and started talking to people, all of those pre-conceived notions you might have had about magic being cheesy immediately disappeared. Anthony was absolutely enthralling. He is exceptionally talented and you feel like you get so much more value out of his show vs. what you see at other corporate events. We will 100% be bringing him back. 5 stars for sure.",
    name: "William R.",
    company: "Eagle Materials",
    image:
      "https://static.wixstatic.com/media/40084f_6f9c3ba5150748f9b631b39ac01dc127~mv2.png/v1/fill/w_225,h_290,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/6.png",
  },
];

// ── Orlando-specific FAQs (verbatim from source) ──────────────────────────────
const orlandoFaqs: FAQ[] = [
  {
    question:
      "I'm thinking about booking a party or event in Orlando, FL. How can I check your availability?",
    answer:
      "If you're in the early stages of planning your party or event, the easiest and fastest way to check my availability is to simply give me a call. I'm also happy to chat with you through email or text, but I tend to lean towards good old-fashioned phone calls because a lot more communication can happen in a few short minutes. If your party or event is in less than a month, reach out immediately. I'll always answer my phone as long as I'm not performing at the time.",
  },
  {
    question:
      "What can I expect when I hire you for my Orlando party or event?",
    answer:
      "There's a reason I have so many 5-star reviews... I set the bar pretty high for myself. First and foremost, when you're ready to book, I'll get your contract sent over that same day (provided I'm out of town for a performance and don't have my computer). I answer your questions or emails promptly. I know how hard it can be planning an upscale event, and the last thing you need is to be hunting down a magician for a copy of liability insurance! Fast-forward to the long-awaited day of your event. You can bet your bottom dollar that I'll be outside waiting in my car at least 20 minutes early (in case you need me to start sooner than expected). I'll enter your event well-dressed and well-groomed, with a smile on my face, ready to captivate your party guests with magic and mentalism. If you've booked my strolling magic and mentalism, I'll be working my way around the party, entertaining small groups of people when they have a break in conversation. You can also expect me to be flexible to a certain extent. If you're running 15 minutes behind or your dinner was served a little late, I'm happy to pause for a bit to accommodate your schedule, providing I don't have another event right after yours. I try to set the bar high so my clients know they're working with the best!",
  },
];
---

<LocationPageContent
  pageTitle="Orlando Magician | Corporate Event Entertainment"
  metaDescription="Orlando's elite magician & mentalist. As seen on FOX, NBC & CW, Anthony stuns at trade shows, corporate events, private parties & more. Book unforgettable entertainment for your event."
  canonicalUrl="https://www.anthonyentertains.com/orlando-fl-magician"
  heroEyebrow="Orlando Magician & Mentalist"
  heroHeadline="Mind-Blowing Magic &amp; Mentalism<br>In Orlando, FL"
  heroSubheadline="Reach Out Today To Find Out How Anthony Can Transform Your Orlando Corporate Event Or Private Party Into An Unforgettable Experience."
  eventTypesTitle="Anthony Is The Magician Orlando Trusts For Events Like These"
  eventTypesNote="Reach out today to find out how to take your party to the next level."
  corporateBody="Orlando is a fantastic location for corporate events. It's easy to get around from the airport, and has countless resorts that can accommodate large groups. Are you bringing your nationwide team to Orlando for an important week of meetings? With so much work on the agenda, there may be no time or energy to leave the resort every day. Allow Anthony to bring quality corporate entertainment right to your resort! He offers an after-dinner interactive comedy magic & mentalism stage show that will involve audience participation. Alternatively, Anthony also offers 'strolling' magic and mentalism, more suitable for a cocktail hour or social setting. With this option, he will mix and mingle with the crowd, enchanting small clusters of guests with his unmatched skill. Anthony's relaxed approach to performance can help employees and clients make new connections, creating a more close-knit team. Anthony is the #1 performing corporate magician for a reason- people leave the event excited and amazed!"
  privateBody="Want to throw a party in Orlando that people will be talking about for years to come? Look no further! Anthony is here to bring unforgettable entertainment to your event. Whether it's jaw-dropping magic tricks performed right before your eyes or a mind-bending mentalism act, Anthony will ensure your guests are blown away. And if you're looking for something on a grander scale, he can even put on a full-stage show in your living room! Give your party the wow factor it deserves with Anthony as your entertainer."
  stageBody="Get ready to be amazed, Orlando! Anthony's Magic & Mind Reading Stage Show will put your guests and company in the spotlight. This fully customizable stage show guarantees an unforgettable experience where your guests become the stars. With his 20 years of stage experience, Anthony commands the stage and captivates his audience with his interactive magic and mentalism show. Anthony's stage shows are great for large-scale events, product launches, fundraiser galas, holiday parties, and as a break from symposium sessions."
  servingAreas="Serving the <a href='https://www.visitorlando.com/' target='_blank' rel='noopener noreferrer'>Orlando Area</a>, <a href='https://cityoflakebuenavistafl.gov/about-us/' target='_blank' rel='noopener noreferrer'>Lake Buena Vista</a>, <a href='https://cityofbaylakefl.gov/about-us/' target='_blank' rel='noopener noreferrer'>Bay Lake</a>, <a href='https://www.experiencekissimmee.com/' target='_blank' rel='noopener noreferrer'>Kissimmee</a>, Dr. Phillips and more."
  testimonialsTitle="CLIENTS WHO LOVE ANTHONY'S ORLANDO, FL ENTERTAINMENT"
  testimonials={orlandoTestimonials}
  faqs={orlandoFaqs}
/>

