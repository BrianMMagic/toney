---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout
  title="Blog | Anthony Entertains"
  description="Read Anthony Dempsey's blog for tips on corporate entertainment, wedding magic, trade show magic, and more from Dallas' favorite magician and mentalist."
>
  <!-- Hero -->
  <Hero
    eyebrow="Anthony's Blog"
    headline="Magic, Mentalism **& Event Tips**"
    bgImage="images/hero/anthony-dempsey-hero.jpg"
  />

  <!-- Blog Listing -->
  <section class="section blog-listing">
    <div class="container">
      <span class="section-label" data-reveal="fade-up">Latest Articles</span>
      <h2 class="section-title" data-reveal="fade-up">Anthony's Blog</h2>
      <div class="divider" data-reveal="fade-up"></div>

      {posts.length === 0 && (
        <p class="no-posts">Blog posts coming soon. Check back shortly!</p>
      )}

      <div class="blog-grid" data-reveal-stagger>
        {posts.map((post) => (
          <article class="blog-card">
            {post.data.heroImage && (
              <a href={`${base}post/${post.id}`} class="blog-card-thumb-link">
                <div class="blog-card-thumb">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    loading="lazy"
                    width="600"
                    height="400"
                  />
                </div>
              </a>
            )}
            <div class="blog-card-body">
              <div class="blog-meta">
                <time class="blog-date" datetime={post.data.pubDate}>
                  {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                {post.data.readTime && (
                  <span class="blog-read-time">{post.data.readTime} read</span>
                )}
                {post.data.category && (
                  <span class="blog-category">{post.data.category}</span>
                )}
              </div>
              <h2 class="blog-card-title">
                <a href={`${base}post/${post.id}`}>{post.data.title}</a>
              </h2>
              {post.data.description && (
                <p class="blog-card-excerpt">{post.data.description}</p>
              )}
              <div class="blog-card-footer">
                <span class="blog-author">Anthony Dempsey</span>
                <a href={`${base}post/${post.id}`} class="blog-read-more">Read More →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.blog-card {
  background: var(--c-card-bg);
  border: 1px solid var(--c-card-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition:
    background   var(--transition-fast),
    transform    0.3s var(--ease-out-quint),
    box-shadow   0.3s var(--ease-out-quint);
}
@media (hover: hover) {
  .blog-card:hover {
    background: var(--c-card-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
}

.blog-card-thumb-link {
  display: block;
  overflow: hidden;
}

.blog-card-thumb {
  width: 100%;
  aspect-ratio: 3 / 2;
  overflow: hidden;
}

.blog-card-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.blog-card:hover .blog-card-thumb img {
  transform: scale(1.04);
}

.blog-card-body {
  padding: 24px 28px 28px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.blog-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.blog-date {
  font-size: 0.78rem;
  color: var(--c-dark-muted);
  font-weight: 400;
}

.blog-read-time {
  font-size: 0.75rem;
  color: var(--c-dark-muted);
  font-weight: 400;
}

.blog-read-time::before {
  content: '·';
  margin-right: 10px;
  opacity: 0.5;
}

.blog-category {
  font-size: 0.72rem;
  font-weight: 500;
  border: 1px solid rgba(20, 21, 29, 0.15);
  padding: 2px 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--c-dark-muted);
}

.blog-card-title {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 400;
  margin-bottom: 12px;
  line-height: 1.3;
  letter-spacing: -0.01em;
}
.blog-card-title a {
  color: var(--c-brand-navy);
  text-decoration: none;
  transition: color var(--transition-fast);
}
.blog-card-title a:hover { color: var(--c-dark-base); }

.blog-card-excerpt {
  font-size: 0.88rem;
  color: var(--c-dark-muted);
  line-height: 1.7;
  max-width: none;
  margin-bottom: 20px;
  flex: 1;
}

.blog-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
}

.blog-author {
  font-size: 0.78rem;
  color: var(--c-dark-muted);
  font-weight: 500;
}

.blog-read-more {
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--c-dark-muted);
  text-decoration: none;
  transition: color var(--transition-fast);
  white-space: nowrap;
}
.blog-read-more:hover { color: var(--c-brand-navy); }

.no-posts {
  color: var(--c-dark-muted);
  font-size: 1rem;
  text-align: center;
  padding: 60px 0;
}

@media (max-width: 900px) {
  .blog-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 540px) {
  .blog-grid { grid-template-columns: 1fr; }
}
</style>
