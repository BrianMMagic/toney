---
import LocationPageContent from '../components/LocationPageContent.astro';
import type { FAQ } from '../data/faqs';
import type { Testimonial } from '../data/testimonials';

const grandRapidsFaqs: FAQ[] = [
  {
    question: "I'm thinking about booking a party or event in Grand Rapids, MI. How can I check your availability?",
    answer:
      "If you're in the early stages of planning your party or event, the easiest and fastest way to check my availability is to simply give me a call. I'm also happy to chat with you through email or text, but I tend to lean towards good old-fashioned phone calls because a lot more communication can happen in a few short minutes. If your party or event is in less than a month, reach out immediately. Although my calendar gets decently filled up a couple of months in advance, the month can get pretty crazy with last-minute bookings to fill in the cracks. But unless I'm on stage or performing at the time, I'll always answer my phone.\n\nFor additional information, check out this blog post: How Hiring a Magician Can Make Your Event Unforgettable (https://www.anthonyentertains.com/post/how-hiring-a-magician-makes-a-party-unforgettable)",
  },
  {
    question: "What can I expect when I hire you for my Grand Rapids corporate event?",
    answer:
      "There's a reason I have so many 5-star reviews... I set the bar pretty high for myself. First and foremost, when you first reach out to me to book, I'll get your contract sent over that same day (unless I'm away from my desk for a performance). I answer your questions or emails promptly. I know how hard it can be planning an upscale event, and the last thing you need is to be hunting down a magician for a copy of liability insurance! Fast-forward to the long-awaited day of your event. You can bet your bottom dollar that I'll be outside waiting in my car at least 20 minutes early (in case you need me to start sooner than expected). I'll enter your event well-dressed and well-groomed, with a smile on my face, ready to start captivating your party guests with magic and mentalism. I'm aware that my performance is a reflection of your company, so you can expect clean humor and professionalism. If you've booked my strolling magic and mentalism, I'll be working my way around the party, entertaining small groups of people when they have a break in conversation. You can also expect me to be flexible to a certain extent. If you're running 15 minutes behind or your dinner was served a little late, I'm happy to pause for a bit to accommodate your schedule, providing I don't have another event right after yours. So yeah, I try to set the bar high so my clients know they're working with the best!",
  },
];

const grandRapidsTestimonials: Testimonial[] = [
  {
    quote:
      "Every person in the room got to experience his skills and every single person was amazed! The attendees are STILL talking about the things he showed us. I usually am a bit skeptical of people performing magic and mind tricks, but Anthony made me a believer. I still have no idea how he knew what I was thinking, but I was very glad that we hired him. He was as funny as he was entertaining!",
    name: 'Randall S.',
    company: 'Nissan',
  },
  {
    quote:
      "Anthony was an absolute hit at my corporate event. I needed quality entertainment as I had a venue full of valued clients I wanted to impress. Anthony did an awesome job of \"reading\" the guests' conversations and approaching at the perfect time. He actually surprised a lot of people because he blended in so professionally! My clients loved him and appreciated unique entertainment and opposed to shouting over DJ or band. Will absolutely be using Anthony for future events.",
    name: 'Virginia B.',
    company: 'Expedia',
  },
  {
    quote:
      "Anthony performed at one of our recent company hosted dinner events and I was absolutely blown away. The moment he walked in and started talking to people, all of those pre-conceived notions you might have had about magic being cheesy immediately disappeared. Anthony was absolutely enthralling. He is exceptionally talented and you feel like you get so much more value out of his show vs. what you see at other corporate events. We will 100% be bringing him back. 5 stars for sure.",
    name: 'William R.',
    company: 'Eagle Materials',
  },
];
---

<LocationPageContent
  pageTitle="Grand Rapids Magician | Corporate Event Entertainment"
  metaDescription="Anthony's quick wit and technical skill make him the ideal choice for corporate and private events, trade shows and product launches. As seen on FOX, NBC, & CW."
  canonicalUrl="https://anthonyentertains.com/grand-rapids-magician"
  heroEyebrow="Grand Rapids Magician & Mentalist"
  eventTypesTitle="Anthony Is The Magician Michigan Trusts For Events Like These"
  eventTypesNote="Here to help you make your event memorable and meaningful!"
  heroHeadline="Mind-Blowing Magic &amp; Mentalism<br>In Grand Rapids, MI"
  heroSubheadline="Want to elevate your Grand Rapids corporate event? Contact Corporate Magician Anthony Dempsey to make your gathering unforgettable! Don't miss the chance to create a truly special experience."
  corporateBody="Nobody likes attending boring work events. With Grand Rapids Magician Anthony Dempsey, traditional work parties are a thing of the past! Anthony will mingle with guests throughout your event, showcasing hilarious, mind-blowing magic and mentalism that captivates small groups. Whether it's a laid-back cocktail hour or a grand annual meeting, he'll help your employees forge new connections and strengthen their teamwork, ensuring your event is memorable and meaningful!"
  privateBody="Looking to host an unforgettable party in Grand Rapids? Anthony is your go-to entertainer for an experience that your guests will talk about long after the evening ends! With mesmerizing magic tricks and astonishing mentalism acts, he guarantees to captivate everyone in the room. For those wanting something a bit more grand, Anthony can transform your living room into a stage for a modified stage show! Elevate your event and let Anthony create the magic your party deserves."
  stageBody="Experience the extraordinary in Grand Rapids with Anthony's Magic & Mind Reading Stage Show! This fully customizable performance ensures your guests are in the spotlight, creating a unique experience where they become the stars. With 20 years of stage experience, Anthony captivates audiences with his incredible magic and mentalism, making it perfect for large-scale events, product launches, fundraisers, holiday parties, and symposium breaks."
  servingAreas="Serving Grand Rapids, Grandville, Kentwood, Holland, Hudsonville, Wyoming, Walker, Rockford, Ada, and Norton Shores."
  faqs={grandRapidsFaqs}
  guaranteesLabel="The Recipe For a Truly Memorable Event"
  testimonialsTitle="CLIENTS WHO LOVE ANTHONY'S GRAND RAPIDS ENTERTAINMENT"
  testimonials={grandRapidsTestimonials}
/>

