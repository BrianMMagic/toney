---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VideoGrid from '../components/VideoGrid.astro';
import ContactForm from '../components/ContactForm.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="GET A QUOTE | United States | Anthony Entertains"
  description="Corporate Magican and Mentalist. Mind Reader. Based in Dallas, Anthony Entertains for Unique Corporate Events as well as any Private Party that needs a Fun and Interactive Entertainer. Whether you are having a Wedding, Holiday Party, Trade Show or Sales Meeting, Anthony will make your next private function a hit!"
  canonicalUrl="https://anthonyentertains.com/get-a-quote"
>
  <!-- Hero -->
  <Hero
    headline="GET A QUOTE"
    subheadline="Please check your junk mail shortly after filling out this form. Our reply can sometimes end up there."
    bgImage="https://static.wixstatic.com/media/40084f_670e7f3b2ef74dea8698d9106c503529~mv2_d_6000_4000_s_4_2.jpg/v1/crop/x_0,y_0,w_4880,h_4000/fill/w_488,h_400,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Magnifying-Glass-Eyeball-bricks.jpg"
  />

  <!-- Contact Form -->
  <ContactForm
    title="Let's Make Your Event Unforgettable"
    label="Contact Anthony"
    showFullForm={true}
  />

  <!-- Videos -->
  <VideoGrid />
</BaseLayout>
