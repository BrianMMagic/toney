---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VideoGrid from '../components/VideoGrid.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="GET A QUOTE | United States | Anthony Entertains"
  description="Request a free quote from Dallas magician and mentalist Anthony Dempsey for your corporate event, private party, wedding, or any special occasion."
  canonicalUrl="https://anthonyentertains.com/get-a-quote"
>
  <!-- Hero -->
  <Hero
    eyebrow="Dallas Magician & Mentalist"
    headline="GET A QUOTE"
    subheadline="Please check your junk mail shortly after filling out this form. Our reply can sometimes end up there."
    ctaText="Watch Anthony Perform"
    ctaHref="#media"
    bgImage="images/hero/anthony-dempsey-hero.jpg"
    overlay="rgba(0,0,0,0.65)"
    minHeight="50vh"
  />

  <!-- Quote Form Section -->
  <section class="section quote-section">
    <div class="container">
      <div class="quote-layout">
        <!-- Contact Info -->
        <div class="quote-info" data-reveal="fade-right">
          <span class="section-label">Contact Anthony</span>
          <h2 class="section-title">Let's Make Your Event Unforgettable</h2>
          <div class="divider"></div>

          <div class="contact-details">
            <div class="contact-item">
              <span class="contact-label">Phone</span>
              <a href="tel:9406540699" class="contact-value">940-654-0699</a>
            </div>
            <div class="contact-item">
              <span class="contact-label">Email</span>
              <a href="mailto:Anthony@AnthonyEntertains.com" class="contact-value">Anthony@AnthonyEntertains.com</a>
            </div>
            <div class="contact-item">
              <span class="contact-label">Response Time</span>
              <span class="contact-value">Within 24 hours</span>
            </div>
            <div class="contact-item">
              <span class="contact-label">Availability</span>
              <span class="contact-value">Always Open</span>
            </div>
          </div>

          <p class="quote-note">
            Anthony will be in touch within 24 hours. Please check your junk folder if you don't see a quick reply. Thanks!
          </p>
        </div>

        <!-- Form -->
        <div class="quote-form-wrap" data-reveal="fade-left">
          <form class="quote-form" name="get-a-quote" method="POST" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="get-a-quote" />
            <p style="display:none"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>
            <div class="form-row">
              <div class="form-group">
                <label for="first-name">First Name *</label>
                <input type="text" id="first-name" name="first-name" required placeholder="Jane" />
              </div>
              <div class="form-group">
                <label for="last-name">Last Name *</label>
                <input type="text" id="last-name" name="last-name" required placeholder="Smith" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required placeholder="jane@company.com" />
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="(555) 555-5555" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="company">Company / Organization</label>
                <input type="text" id="company" name="company" placeholder="Acme Corp" />
              </div>
              <div class="form-group">
                <label for="event-date">Event Date</label>
                <input type="date" id="event-date" name="event-date" />
              </div>
            </div>

            <div class="form-group">
              <label for="event-type">Type of Event</label>
              <select id="event-type" name="event-type">
                <option value="">Select event type…</option>
                <option>Corporate Event</option>
                <option>Holiday Party</option>
                <option>Trade Show</option>
                <option>Birthday Party</option>
                <option>Wedding</option>
                <option>Private Party</option>
                <option>Other</option>
              </select>
            </div>

            <div class="form-group">
              <label for="budget">Estimated Budget</label>
              <select id="budget" name="budget">
                <option value="">Select a range…</option>
                <option>Under $1,000</option>
                <option>$1,000 – $2,000</option>
                <option>$2,000 – $3,500</option>
                <option>$3,500 – $5,000</option>
                <option>$5,000+</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Tell me about your event *</label>
              <textarea id="message" name="message" required rows="6" placeholder="Location, guest count, what you're envisioning…"></textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--full">Send My Request</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Videos -->
  <VideoGrid />
</BaseLayout>

<style>
.quote-layout {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 80px;
  align-items: start;
}

.quote-info .section-title { margin-bottom: 0; }

.contact-details {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin: 32px 0;
}

.contact-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.contact-label {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.contact-value {
  font-size: 1rem;
  color: var(--color-text);
  text-decoration: none;
  transition: color var(--transition-fast);
}
a.contact-value:hover { color: var(--color-accent-light); }

.quote-note {
  font-size: 0.88rem;
  color: var(--color-text-muted);
  line-height: 1.7;
  max-width: none;
  padding: 16px 20px;
  border-left: 3px solid var(--c-brand-gold);
  background: rgba(179, 140, 97, 0.08);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

.quote-form-wrap {
  background: var(--color-surface);
  border: 1px solid var(--c-light-15);
  border-radius: var(--radius-lg);
  padding: 48px 40px;
}

.quote-form { display: flex; flex-direction: column; gap: 20px; }

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-group label {
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  text-transform: uppercase;
}

.form-group input,
.form-group select,
.form-group textarea {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  font-size: 0.95rem;
  color: var(--color-text);
  font-family: var(--font-body);
  transition: border-color var(--transition-fast);
  width: 100%;
}
.form-group input::placeholder,
.form-group textarea::placeholder { color: #555; }
.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--c-brand-gold);
}
.form-group select { appearance: none; cursor: pointer; }
.form-group textarea { resize: vertical; }

.btn--full { width: 100%; justify-content: center; }

@media (max-width: 1024px) {
  .quote-layout { grid-template-columns: 1fr; gap: 48px; }
}
@media (max-width: 600px) {
  .form-row { grid-template-columns: 1fr; }
  .quote-form-wrap { padding: 32px 24px; }
}
</style>
