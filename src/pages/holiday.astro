<style>
/* Reviews image section */
.reviews-image-section {
  padding-block: 48px;
}
.reviews-image {
  display: block;
  max-width: 100%;
  height: auto;
  margin: 0 auto;
}

/* Inline video embed sections */
.inline-video-section {
  padding-block: 48px;
  background: var(--color-bg-dark, #14151d);
}
.inline-video-container {
  max-width: 900px;
}
.inline-video-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: 4px;
}
.inline-video-wrapper iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: none;
}

/* Archive block — present in DOM for completeness but not shown visually */
.page-images-archive {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  pointer-events: none;
}
</style>
