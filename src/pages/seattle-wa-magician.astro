---
import LocationPageContent from '../components/LocationPageContent.astro';
import type { FAQ } from '../data/faqs';
import type { Testimonial } from '../data/testimonials';

const seattleFaqs: FAQ[] = [
  {
    question: "I'm thinking about booking a party or event in Seattle, WA. How can I check your availability?",
    answer:
      "If you're in the early stages of planning your party or event, the easiest and fastest way to check my availability is to simply give me a call. I'm also happy to chat with you through email or text, but I tend to lean towards good old-fashioned phone calls because a lot more communication can happen in a few short minutes. If your party or event is in less than a month, reach out immediately. Although my calendar gets decently filled up a couple of months in advance, the month can get pretty crazy with last-minute bookings to fill in the cracks. But unless I'm on stage or performing at the time, I'll always answer my phone.",
  },
  {
    question: "What can I expect when I hire you for my Seattle party or event?",
    answer:
      "There's a reason I have so many 5-star reviews... I set the bar pretty high for myself. First and foremost, when you first reach out to me to book, I'll get your contract sent over that same day (unless I'm out of town for a performance). I answer your questions or emails promptly. I know how hard it can be planning an upscale event, and the last thing you need is to be hunting down a magician for a copy of liability insurance! Fast-forward to the long-awaited day of your event. You can bet your bottom dollar that I'll be outside waiting in my car at least 20 minutes early (in case you need me to start sooner than expected). I'll enter your event well-dressed and well-groomed, with a smile on my face, ready to start captivating your party guests with magic and mentalism. If you've booked my strolling magic and mentalism, I'll be working my way around the party, entertaining small groups of people when they have a break in conversation. You can also expect me to be flexible to a certain extent. If you're running 15 minutes behind or your dinner was served a little late, I'm happy to pause for a bit to accommodate your schedule, providing I don't have another event right after yours. So yeah, I try to set the bar high so my clients know they're working with the best! For more about corporate magicians and mentalists, check out a recent blog here! Looking For Corporate Entertainment?",
  },
];

const seattleTestimonials: Testimonial[] = [
  {
    quote:
      "Every person in the room got to experience his skills and every single person was amazed! The attendees are STILL talking about the things he showed us. I usually am a bit skeptical of people performing magic and mind tricks, but Anthony made me a believer. I still have no idea how he knew what I was thinking, but I was very glad that we hired him. He was as funny as he was entertaining!",
    name: "Randall S.",
    company: "Nissan",
  },
  {
    quote:
      "Anthony was an absolute hit at my corporate event. I needed quality entertainment as I had a venue full of valued clients I wanted to impress. Anthony did an awesome job of \"reading\" the guests' conversations and approaching at the perfect time. He actually surprised a lot of people because he blended in so professionally! My clients loved him and appreciated unique entertainment and opposed to shouting over DJ or band. Will absolutely be using Anthony for future events.",
    name: "Virginia B.",
    company: "Expedia",
  },
  {
    quote:
      "Anthony performed at one of our recent company hosted dinner events and I was absolutely blown away. The moment he walked in and started talking to people, all of those pre-conceived notions you might have had about magic being cheesy immediately disappeared. Anthony was absolutely enthralling. He is exceptionally talented and you feel like you get so much more value out of his show vs. what you see at other corporate events. We will 100% be bringing him back. 5 stars for sure.",
    name: "William R.",
    company: "Eagle Materials",
  },
];
---

<LocationPageContent
  pageTitle="Seattle Magician | Corporate Event Entertainment"
  metaDescription="Anthony delivers sophisticated fun to corporate events, trade shows, and private parties. Elevate your Seattle event with top-tier magic & mentalism seen on FOX, NBC, and CW."
  canonicalUrl="https://anthonyentertains.com/seattle-wa-magician"
  heroEyebrow="Seattle Magician & Mentalist"
  heroHeadline="Mind-Blowing Magic &amp; Mentalism<br>In Seattle, WA"
  heroSubheadline="Reach Out Today To Find Out How Anthony Can Transform Your Seattle Corporate Event Or Private Party Into An Unforgettable Experience."
  corporateBody="There's a lot riding on the success of a corporate event. Clients need to enjoy themselves and be impressed, so you retain those clients; and staff needs to feel appreciated and connect with one another, to reduce employee turnover. Allow Seattle's Premier Magician Anthony Dempsey to captivate your guests with his unique blend of comedy magic and mentalism! He will make sure both clients and staff feel appreciated by your company, and that they leave the event with the feeling of lasting astonishment. Whether it's a casual cocktail hour or a large annual sales meeting, Anthony is flexible and can accommodate a corporate event of any size."
  privateBody="Host a party in your Seattle home that people will be talking about for years to come! Seattle Magician & Mentalist Anthony Dempsey is here to bring sophisticated fun to your home. Whether it's jaw-dropping magic tricks performed right before your eyes or a mind-bending mentalism act, Anthony will ensure your guests are blown away. And if you're looking for something on a grander scale, he can even put on a modified version of his stage show right in your living room! Anthony's entertainment will instantly elevate your event."
  stageBody="Get ready to be amazed, Seattle! Anthony's Magic & Mind Reading Stage Show will put your guests and company in the spotlight. This fully customizable stage show guarantees an unforgettable experience where your guests will be roaring with laughter! If you're in need of a friendly face to guide guests throughout the evening or present awards, Anthony also offers event MC services. With Anthony's 20 years of stage experience, he is prepared to captivate your guests with his unique blend of comedy magic and mentalism. This show has been enjoyed by some of America's top corporations!"
  servingAreas="Serving <a href='https://visitseattle.org/' target='_blank' rel='noopener noreferrer'>Seattle</a>, <a href='https://www.traveltacoma.com/' target='_blank' rel='noopener noreferrer'>Tacoma</a>, <a href='https://experienceredmond.com/' target='_blank' rel='noopener noreferrer'>Redmond</a>, <a href='https://www.explorekirkland.com/' target='_blank' rel='noopener noreferrer'>Kirkland</a>, <a href='https://exploreauburn.com/' target='_blank' rel='noopener noreferrer'>Auburn</a> &amp; surrounding areas."
  eventTypes={['Holiday Parties', 'Anniversaries', 'Corporate Events', 'Cocktail Hours', 'Weddings', 'Adult Birthdays', 'Surprise Entertainment', 'Private Parties']}
  eventTypesTitle="Anthony Is The Magician Seattle Trusts For Events Like These"
  eventTypesTagline="Reach out today to find out how to take your party to the next level."
  eventTypesNote="Make your event unforgettable with Seattle Magician Anthony Dempsey"
  faqs={seattleFaqs}
  guaranteesLabel="Just What You Need For A Truly Memorable Event"
  testimonialsTitle="CLIENTS WHO LOVE ANTHONY'S SEATTLE, WA ENTERTAINMENT"
  testimonials={seattleTestimonials}
/>

