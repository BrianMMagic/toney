---
import LocationPageContent from '../components/LocationPageContent.astro';
import { generalLocationFaqs } from '../data/faqs';
import type { Testimonial } from '../data/testimonials';

const laFaqs = generalLocationFaqs('Los Angeles', 'CA').map((faq, i) => {
  if (i === 0) {
    return {
      ...faq,
      question: "I'm thinking about booking a party or event in Los Angeles. How can I check your availability?",
    };
  }
  if (i === 1) {
    return {
      ...faq,
      question: "What can I expect when I hire you for my Los Angeles, CA party or event?",
    };
  }
  return faq;
});

const laTestimonials: Testimonial[] = [
  {
    quote:
      "Every person in the room got to experience his skills and every single person was amazed! The attendees are STILL talking about the things he showed us. I usually am a bit skeptical of people performing magic and mind tricks, but Anthony made me a believer. I still have no idea how he knew what I was thinking, but I was very glad that we hired him. He was as funny as he was entertaining!",
    name: 'Randall S.',
    company: 'Nissan',
  },
  {
    quote:
      "Anthony was an absolute hit at my corporate event. I needed quality entertainment as I had a venue full of valued clients I wanted to impress. Anthony did an awesome job of 'reading' the guests' conversations and approaching at the perfect time. He actually surprised a lot of people because he blended in so professionally! My clients loved him and appreciated unique entertainment and opposed to shouting over DJ or band. Will absolutely be using Anthony for future events.",
    name: 'Virginia B.',
    company: 'Expedia',
  },
  {
    quote:
      "Anthony performed at one of our recent company hosted dinner events and I was absolutely blown away. The moment he walked in and started talking to people, all of those pre-conceived notions you might have had about magic being cheesy immediately disappeared. Anthony was absolutely enthralling. He is exceptionally talented and you feel like you get so much more value out of his show vs. what you see at other corporate events. We will 100% be bringing him back. 5 stars for sure.",
    name: 'William R.',
    company: 'Eagle Materials',
  },
];
---

<LocationPageContent
  pageTitle="Los Angeles Magician | Corporate Event Entertainment"
  metaDescription="Kick your event up a notch. Los Angeles Magician Anthony Dempsey is the ultimate party guest, delivering jaw-dropping Magic and Mentalism for Corporate Events, Trade Shows, and Private Parties."
  canonicalUrl="https://anthonyentertains.com/los-angeles-ca-magician"
  heroEyebrow="Los Angeles Magician & Mentalist"
  heroHeadline="Mind-Blowing Magic &amp; Mentalism<br>In Los Angeles, CA"
  heroSubheadline="Reach Out Today To Find Out How Anthony Can Transform Your Los Angeles Corporate Event Or Private Party Into An Unforgettable Experience."
  intro="Making Life Not Boring, One Event at a Time"
  corporateBody="Looking to unite your Los Angeles team like never before? Say goodbye to boring work events and welcome the excitement of unforgettable evenings with Los Angeles Magician Anthony Dempsey! Anthony is the essential ingredient for fostering new friendships among your employees. For a casual cocktail hour, he'll mix and mingle with guests, showing them hilarious and jaw-dropping magic & mentalism. A seated corporate event would call for his award-winning comedy magic & mind reading stage show, which is stacked with audience participation and side-splitting humor. Anthony even offers MC services, so your guests have a friendly, entertaining guide throughout the evening."
  privateBody="Want to throw a party in Los Angeles that people will be talking about for years to come? Look no further! Anthony is here to bring unforgettable entertainment to your event. Whether it's jaw-dropping magic tricks performed right before your eyes or a mind-bending mentalism act, Anthony will ensure your guests are blown away. And if you're looking for something on a grander scale, he can even put on a full-stage show in your living room! Give your party the wow factor it deserves with Anthony as your entertainer."
  stageBody="Get ready to laugh and be amazed in Los Angeles! Anthony's Magic & Mind Reading Stage Show will put your guests and company in the spotlight. This customizable modular stage show guarantees an unforgettable experience where your guests become the stars. You can expect high energy comedy and unbelievable magic and mentalism during Anthony's show. Perfect for corporate events, fundraiser galas, colleges, and awards dinners."
  servingAreas="Serving <a href='https://www.discoverlosangeles.com/' target='_blank' rel='noopener noreferrer'>Los Angeles</a>, <a href='https://www.santamonica.com/' target='_blank' rel='noopener noreferrer'>Santa Monica</a>, <a href='https://palisadesvillageca.com/visit/' target='_blank' rel='noopener noreferrer'>Pacific Palisades</a>, <a href='https://www.beverlyhills.org/' target='_blank' rel='noopener noreferrer'>Beverly Hills</a>, <a href='https://www.visitlongbeach.com/' target='_blank' rel='noopener noreferrer'>Long Beach</a>, <a href='https://www.malibucity.org/' target='_blank' rel='noopener noreferrer'>Malibu</a>, <a href='https://www.anaheim.net/' target='_blank' rel='noopener noreferrer'>Anaheim</a> &amp; surrounding areas."
  faqs={laFaqs}
  testimonialsTitle="CLIENTS WHO LOVE ANTHONY'S LOS ANGELES, CA ENTERTAINMENT"
  testimonials={laTestimonials}
/>
