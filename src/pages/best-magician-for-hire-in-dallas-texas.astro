---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PennTellerBadge from '../components/PennTellerBadge.astro';
import EventTypesSection from '../components/EventTypesSection.astro';
import ThreeGuarantees from '../components/ThreeGuarantees.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import VideoGrid from '../components/VideoGrid.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const eventTypes = [
  'Holiday Parties', 'Anniversaries', 'Corporate Events', 'Cocktail Hours',
  'Weddings', 'Adult Birthdays', 'Surprise Entertainment',
];

// Inline testimonials — verbatim from source page
const pageTestimonials = [
  {
    quote: "Every person in the room got to experience his skills and every single person was amazed! The attendees are STILL talking about the things he showed us. I usually am a bit skeptical of people performing magic and mind tricks, but Anthony made me a believer. I still have no idea how he knew what I was thinking, but I was very glad that we hired him. He was as funny as he was entertaining!",
    name: 'Randall S.',
    company: 'Nissan',
  },
  {
    quote: "Anthony was an absolute hit at my corporate event. I needed quality entertainment as I had a venue full of valued clients I wanted to impress. Anthony did an awesome job of \"reading\" the guests' conversations and approaching at the perfect time. He actually surprised a lot of people because he blended in so professionally! My clients loved him and appreciated unique entertainment and opposed to shouting over DJ or band. Will absolutely be using Anthony for future events.",
    name: 'Virginia B.',
    company: 'Expedia',
  },
  {
    quote: "Anthony performed at one of our recent company hosted dinner events and I was absolutely blown away. The moment he walked in and started talking to people, all of those pre-conceived notions you might have had about magic being cheesy immediately disappeared. Anthony was absolutely enthralling. He is exceptionally talented and you feel like you get so much more value out of his show vs. what you see at other corporate events. We will 100% be bringing him back. 5 stars for sure.",
    name: 'William R.',
    company: 'Eagle Materials',
  },
];

// Inline FAQs — verbatim from source page
const pageFaqs = [
  {
    question: "I'm thinking about booking. How can I check your availability?",
    answer: "If you're in the early stages of planning your event, the easiest and fastest way to check my availability is to simply give me a call. I'm happy to chat with you through email or text as well, but I tend to lean towards good old fashioned phone calls because a lot more communication can happen in a few short minutes. If your event is in less than a month, be sure to reach out right away. Although my calendar gets decently filled up a couple months in advance, the month-of can get pretty crazy with last-minute bookings to fill in the cracks. But unless I'm on stage or performing at the time, I'll always answer my phone.",
  },
  {
    question: "What can I expect when I hire you?",
    answer: "There's a reason I have so many 5-star reviews... I set the bar pretty high for myself. First and foremost, when you first reach out to me to book, I'll get your contract sent over that same day (unless I'm out of town for a performance). I answer your questions or emails promptly. I know how hard it can be planning an upscale event, and the last thing you need is to be hunting down a magician for a copy of liability insurance! Fast-forward to the long-awaited day of your event. You can bet your bottom dollar that I'll be outside waiting in my car at least 20 minutes early (in case you need me to start sooner than expected). I'll enter your event well-dressed and well-groomed, with a smile on my face, ready to start captivating your party guests with magic and mentalism. If you've booked my strolling magic and mentalism, I'll be working my way around the party, entertaining small groups of people when they have a break in conversation. You can also expect me to be flexible to a certain extent. If you're running 15 minutes behind or your dinner was served a little late, I'm happy to pause for a bit to accommodate your schedule, providing I don't have another event right after yours. So yeah, I try to set the bar high so my clients know they're working with the best!",
  },
];
---

<BaseLayout
  title="The BEST Magician to Hire in Dallas, Texas"
  description="AS SEEN ON PENN &amp; TELLER FOOL US! Award Winning Dallas Magician Anthony Dempsey is the ultimate party guest! Magic and Mentalism for Corporate Events and Private Parties. Perfect for Trade Show Booths, Weddings, Birthdays, Sales Meetings, and Anniversaries."
  canonicalUrl="https://anthonyentertains.com/best-magician-for-hire-in-dallas-texas"
>
  <!-- Hero -->
  <Hero
    eyebrow="DALLAS' FAVORITE MAGICIAN &amp; MENTALIST"
    headline="The BEST Magician to Hire in Dallas, Texas"
    nameDisplay="Anthony Dempsey"
    subheadline="Reach Out Today To Find Out How Anthony Can Transform Your Event Into An Unforgettable Experience."
    ctaText="Get a Free Quote"
    ctaHref={`${base}get-a-quote`}
    ctaSecondaryText="More Videos"
    ctaSecondaryHref="#media"
    bgImage="images/hero/anthony-dempsey-hero.jpg"
    overlay="rgba(0,0,0,0.62)"
  />

  <!-- Hero secondary CTA — "MORE VIDEOS" (source page button) -->
  <div class="hero-more-videos-bar">
    <a href="#media" class="hero-more-videos-link">MORE VIDEOS</a>
  </div>

  <!-- Penn & Teller -->
  <PennTellerBadge />

  <!-- Event Types -->
  <EventTypesSection
    title="Anthony Is The Magician Dallas Trusts For Events Like These"
    events={eventTypes}
    note="Reach out today to find out how to take your party to the next level."
  />

  <!-- Services Overview -->
  <section class="section">
    <div class="container">
      <span class="section-label" data-reveal="fade-up">Services</span>
      <h2 class="section-title" data-reveal="fade-up">Make your event unforgettable with Dallas Magician Anthony Dempsey</h2>
      <div class="divider" data-reveal="fade-up"></div>

      <div class="best-services-grid" data-reveal-stagger>
        <article class="best-service-card">
          <h3>Corporate Events</h3>
          <p>Connect your employees in a whole new way! Whether it's an intimate cocktail hour or your yearly sales meeting, Anthony is the secret to helping your employees build new friendships. They'll have an unforgettable evening all thanks to you! Dallas Magician Anthony Dempsey can't wait to make your event a hit with his corporate entertainment!</p>
          <a href={`${base}corporate-magician`} class="service-link">Learn More →</a>
        </article>

        <article class="best-service-card">
          <h3>Private Parties</h3>
          <p>Make your party stand out from the rest! After all, what's a party without unforgettable entertainment? From Strolling Magic &amp; Mentalism amongst the guests to a full living room Stage Show, Anthony will make your party a night that guests will NEVER forget! Serving Dallas, Fort Worth, Plano, Addison, Arlington, McKinney, Irving, Grapevine, Frisco, and more.</p>
          <a href={`${base}private-party-magician`} class="service-link">Learn More →</a>
        </article>

        <article class="best-service-card">
          <h3>Stage Shows</h3>
          <p>Put your guests and company in the spotlight! With a completely customizable Magic &amp; Mind Reading Stage Show, your guests will not only experience the impossible, but also be the stars of the show! With over 20 years' experience on stage, Anthony will truly captivate your party guests with his magic show.</p>
          <a href={`${base}services`} class="service-link">Learn More →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Guarantees -->
  <ThreeGuarantees
    label="Unlock the Secrets of a Truly Memorable Event"
    title="Anthony Guarantees:"
  />

  <!-- Testimonials -->
  <TestimonialsSection
    testimonials={pageTestimonials}
    title="Client Testimonials"
  />

  <!-- Videos -->
  <VideoGrid />

  <!-- About -->
  <AboutSection />

  <!-- Contact -->
  <ContactForm showFullForm={true} />

  <!-- FAQ -->
  <FAQSection faqs={pageFaqs} />

  <!-- Page images — all source URLs preserved for SEO and content completeness -->
  <div class="page-images" aria-hidden="true">
    <img src="https://static.wixstatic.com/media/40084f_ef998d763cf64f06b5cda2c8a7d3dee7~mv2.jpg/v1/fill/w_1280,h_720,al_t,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/40084f_ef998d763cf64f06b5cda2c8a7d3dee7~mv2.jpg" alt="" loading="lazy" width="1280" height="720" />
