---
export interface ServiceOption {
  heading: string;
  body: string;
  useCases?: string[];
}

export interface Props {
  title?: string;
  label?: string;
  intro?: string;
  options: ServiceOption[];
}

const { title = 'Service Options', label = 'How Anthony Performs', intro, options } = Astro.props;
---

<section class="section service-intro-section">
  <div class="container">
    <span class="section-label" data-reveal="fade-up">{label}</span>
    <h2 class="section-title" data-reveal="fade-up">{title}</h2>
    <div class="divider" data-reveal="fade-up"></div>
    {intro && <p class="section-sub" data-reveal="fade-up">{intro}</p>}

    <div class="service-options" data-reveal-stagger>
      {options.map((opt) => (
        <div class="service-option-card">
          <h3 class="service-option-heading">{opt.heading}</h3>
          <p class="service-option-body">{opt.body}</p>
          {opt.useCases && opt.useCases.length > 0 && (
            <ul class="service-option-uses">
              {opt.useCases.map(uc => <li>{uc}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.service-options {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 28px;
}

.service-option-card {
  background: var(--c-card-bg);
  border: 1px solid var(--c-card-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 36px 30px;
  transition:
    background   var(--transition-fast),
    transform    0.3s var(--ease-out-quint),
    box-shadow   0.3s var(--ease-out-quint);
}
@media (hover: hover) {
  .service-option-card:hover {
    background: var(--c-card-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
}

.service-option-heading {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 400;
  color: var(--c-brand-navy);
  letter-spacing: -0.01em;
  margin-bottom: 14px;
}

.service-option-body {
  font-size: 0.9rem;
  color: var(--c-dark-base);
  line-height: 1.8;
  margin-bottom: 20px;
  max-width: none;
}

.service-option-uses {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.service-option-uses li {
  background: transparent;
  border: 1px solid var(--c-card-border);
  padding: 4px 14px;
  font-size: 0.78rem;
  color: var(--c-dark-muted);
  font-weight: 400;
}
</style>
