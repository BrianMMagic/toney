---
export interface Props {
  headline: string;
  subheadline?: string;
  eyebrow?: string;
  nameDisplay?: string;
  bgImage?: string;
  ctaText?: string;
  ctaHref?: string;
  ctaSecondaryText?: string;
  ctaSecondaryHref?: string;
  minHeight?: string;
  overlay?: string;
  align?: 'center' | 'left';
}

const {
  headline,
  subheadline,
  eyebrow,
  nameDisplay,
  bgImage = '/images/hero/anthony-dempsey-hero.jpg',
  ctaText = 'Get a Free Quote',
  ctaHref,
  align = 'left',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const resolvedCta = ctaHref ?? `${base}get-a-quote`;
const resolvedBg = bgImage.startsWith('http') ? bgImage : `${base}${bgImage.replace(/^\//, '')}`;

const headlineHtml = headline
  .split(/(\*\*[^*]+\*\*)/g)
  .map(part =>
    part.startsWith('**') && part.endsWith('**')
      ? `<em>${part.slice(2, -2)}</em>`
      : part
  )
  .join('');
---

<section class="hero-split">

  <!-- Left: text column on white -->
  <div class="hero-split__left">

    {eyebrow && (
      <span class="hero-split__eyebrow hero-animate">{eyebrow}</span>
    )}

    <h1
      class="hero-split__headline hero-animate hero-animate--delay-1"
      set:html={headlineHtml}
    />

    {nameDisplay && (
      <p class="hero-split__name hero-animate hero-animate--delay-2">{nameDisplay}</p>
    )}

    {subheadline && (
      <p class="hero-split__sub hero-animate hero-animate--delay-2">{subheadline}</p>
    )}

    <div class="hero-split__actions hero-animate hero-animate--delay-3">
      <a href={resolvedCta} class="btn btn--primary btn--lg">{ctaText}</a>
    </div>

    <div class="hero-split__badge hero-animate hero-animate--delay-4">
      <span class="hero-split__badge-label">As seen on</span>
      <span class="hero-split__badge-text">Penn &amp; Teller: Fool Us</span>
    </div>

    <!-- Decorative blobs behind left text -->
    <div class="hero-blobs" aria-hidden="true">
      <div class="hero-blob hero-blob--1"></div>
      <div class="hero-blob hero-blob--2"></div>
    </div>
  </div>

  <!-- Right: full-bleed photo with overlay gradient -->
  <div class="hero-split__right">
    <img
      src={resolvedBg}
      alt="Anthony Dempsey — Dallas Magician & Mentalist"
      class="hero-split__img"
      fetchpriority="high"
      decoding="async"
    />
    <!-- Gradient fade at bottom for smooth transition -->
    <div class="hero-split__gradient" aria-hidden="true"></div>
  </div>

</section>

<style>
/* ── Hero Split Layout ────────────────────────────────────── */
.hero-split {
  display: grid;
  grid-template-columns: 45fr 55fr;
  min-height: 100vh;
  background: var(--c-light-base);
  position: relative;
  overflow: hidden;
}

/* ── Left text column ────────────────────────────────────── */
.hero-split__left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(100px, 10vh, 140px) var(--gutter) 80px;
  background: var(--c-light-base);
  position: relative;
  z-index: 2;
  /* Thin right border matching reference site */
  border-right: 1px solid var(--color-border);
}

/* ── Decorative background blobs ─────────────────────────── */
.hero-blobs {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: -1;
}

.hero-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(70px);
  opacity: 0.08;
}

.hero-blob--1 {
  background: var(--c-brand-navy);
  width: 420px;
  height: 420px;
  top: -80px;
  right: -100px;
  animation: blob-drift-1 14s ease-in-out infinite alternate;
}

.hero-blob--2 {
  background: var(--c-brand-teal);
  width: 300px;
  height: 300px;
  bottom: 40px;
  left: -60px;
  animation: blob-drift-2 18s ease-in-out infinite alternate;
}

@keyframes blob-drift-1 {
  0%   { transform: translate(0, 0) rotate(0deg); }
  100% { transform: translate(10%, 15%) rotate(18deg); }
}
@keyframes blob-drift-2 {
  0%   { transform: translate(0, 0) rotate(-8deg); }
  100% { transform: translate(-8%, 10%) rotate(-22deg); }
}

/* ── Eyebrow label ─────────────────────────────────────────── */
.hero-split__eyebrow {
  display: block;
  font-family: var(--font-body);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--c-brand-teal);
  margin-bottom: 20px;
}

/* ── Display headline ──────────────────────────────────────── */
.hero-split__headline {
  font-family: var(--font-heading);
  font-size: clamp(3.4rem, 7vw, 7.5rem);
  font-weight: 400;
  line-height: 1.0;
  letter-spacing: -0.03em;
  color: var(--c-brand-navy);
  margin-bottom: 28px;
  max-width: 11ch;
}

.hero-split__headline em {
  font-style: italic;
  font-weight: 400;
}

/* ── Name display ──────────────────────────────────────────── */
.hero-split__name {
  font-family: var(--font-heading);
  font-size: clamp(1.4rem, 2.5vw, 2rem);
  font-style: italic;
  color: var(--c-dark-muted);
  margin-bottom: 16px;
  line-height: 1.2;
}

/* ── Subtitle ──────────────────────────────────────────────── */
.hero-split__sub {
  font-family: var(--font-body);
  font-size: clamp(0.95rem, 1.3vw, 1.1rem);
  color: var(--c-dark-base);
  line-height: 1.65;
  margin-bottom: 40px;
  max-width: 46ch;
}

/* ── CTA actions ───────────────────────────────────────────── */
.hero-split__actions {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 48px;
}

/* ── Penn & Teller badge ───────────────────────────────────── */
.hero-split__badge {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.hero-split__badge-label {
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--c-dark-muted);
}
.hero-split__badge-text {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-style: italic;
  color: var(--c-brand-navy);
}

/* ── Right image column ────────────────────────────────────── */
.hero-split__right {
  position: relative;
  overflow: hidden;
}

.hero-split__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  /* Subtle scale on load for a cinematic feel */
  animation: hero-img-reveal 1.4s var(--ease-theatrical) both;
}

@keyframes hero-img-reveal {
  from { transform: scale(1.06); }
  to   { transform: scale(1); }
}

/* Bottom gradient fade on the photo */
.hero-split__gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 220px;
  background: linear-gradient(to top, var(--c-brand-navy) 0%, transparent 100%);
  opacity: 0.25;
  pointer-events: none;
}

/* ── Responsive ────────────────────────────────────────────── */
@media (max-width: 960px) {
  .hero-split {
    grid-template-columns: 1fr;
    grid-template-rows: auto 62vw;
    min-height: auto;
  }

  .hero-split__left {
    padding: 110px 20px 48px;
    text-align: center;
    align-items: center;
    border-right: none;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-split__headline { max-width: 100%; }
  .hero-split__sub      { max-width: 100%; }

  .hero-split__actions {
    justify-content: center;
    margin-bottom: 32px;
  }

  .hero-split__badge { align-items: center; }

  .hero-split__right {
    height: 62vw;
    min-height: 300px;
    position: relative;
  }

  .hero-blob--1 { width: 260px; height: 260px; }
  .hero-blob--2 { width: 200px; height: 200px; }
}

@media (max-width: 480px) {
  .hero-split__left { padding: 100px 20px 40px; }
  .hero-split__headline { font-size: clamp(2.8rem, 14vw, 4rem); }
}
</style>
