---
import { services, locations, mainNav } from '../data/nav';
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href={`${base}`} class="logo" aria-label="Anthony Entertains — Home">
      <span class="logo-name">Anthony</span>
      <span class="logo-tag">Entertains</span>
    </a>

    <!-- Desktop: minimal right-side controls -->
    <div class="header-right">
      <!-- Phone -->
      <a href="tel:+19406540699" class="header-phone" aria-label="Call Anthony">
        940-654-0699
      </a>
      <!-- CTA pill -->
      <a href={`${base}get-a-quote`} class="btn btn--primary header-cta">
        Get a Free Quote
      </a>
      <!-- Menu toggle (all sizes) -->
      <button class="header-menu-btn" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="header-menu-text">Menu</span>
        <span class="header-menu-icon" aria-hidden="true">
          <span></span><span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Full-screen overlay menu -->
<div class="nav-overlay" id="mobile-menu" aria-hidden="true">
  <button class="nav-overlay__close" id="mobile-close" aria-label="Close menu">
    <span aria-hidden="true">✕</span>
  </button>

  <nav class="nav-overlay__nav" aria-label="Main navigation">
    <ul class="nav-overlay__list">
      <li><a href={`${base}`} class="nav-overlay__link">Home</a></li>

      <!-- Services group -->
      <li class="nav-overlay__group">
        <button class="nav-overlay__group-label" aria-expanded="false">
          Services
          <svg class="nav-overlay__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="nav-overlay__sub nav-overlay__sub--cols2" hidden>
          {services.map(s => (
            <li><a href={`${base}${s.href.replace(/^\//, '')}`} class="nav-overlay__sub-link">{s.label}</a></li>
          ))}
        </ul>
      </li>

      <!-- Locations group -->
      <li class="nav-overlay__group">
        <button class="nav-overlay__group-label" aria-expanded="false">
          Locations
          <svg class="nav-overlay__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="nav-overlay__sub nav-overlay__sub--cols3" hidden>
          {locations.map(l => (
            <li><a href={`${base}${l.href.replace(/^\//, '')}`} class="nav-overlay__sub-link">{l.label}</a></li>
          ))}
        </ul>
      </li>

      {mainNav.filter(n => !['Home', 'Services', 'Locations'].includes(n.label)).map(n => (
        <li>
          <a href={n.href.startsWith('/') ? `${base}${n.href.replace(/^\//, '')}` : n.href} class="nav-overlay__link">{n.label}</a>
        </li>
      ))}
    </ul>

    <a href={`${base}get-a-quote`} class="btn btn--secondary nav-overlay__cta">Get a Free Quote</a>
  </nav>

  <div class="nav-overlay__bottom">
    <a href="tel:+19406540699" class="nav-overlay__tel">940-654-0699</a>
  </div>
</div>

<style>
/* ── Header shell ───────────────────────────────────────────── */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: background 0.3s ease, backdrop-filter 0.3s ease;
}

.site-header.scrolled {
  background: rgba(255, 255, 255, 0.96);
}

/* On dark sections the header inverts */
.site-header.on-dark {
  background: rgba(73, 29, 53, 0.94);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* ── Inner layout ───────────────────────────────────────────── */
.header-inner {
  max-width: var(--max-width, 1280px);
  margin: 0 auto;
  padding: 0 var(--gutter, 32px);
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ── Logo ───────────────────────────────────────────────────── */
.logo {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
  flex-shrink: 0;
  gap: 1px;
}
.logo-name {
  font-family: var(--font-heading);
  font-size: 1.3rem;
  font-weight: 400;
  color: var(--c-brand-navy);
  letter-spacing: -0.01em;
}
.logo-tag {
  font-family: var(--font-body);
  font-size: 0.6rem;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--c-dark-muted);
}

/* ── Right controls ─────────────────────────────────────────── */
.header-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Phone link */
.header-phone {
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--c-brand-navy);
  padding: 8px 16px;
  border-radius: var(--radius-pill);
  border: 1.5px solid rgba(73, 29, 53, 0.22);
  transition: border-color var(--transition-fast), background var(--transition-fast);
  white-space: nowrap;
}
.header-phone:hover {
  border-color: var(--c-brand-navy);
  background: rgba(73, 29, 53, 0.06);
}

/* CTA button */
.header-cta {
  padding: 10px 22px;
  font-size: 0.82rem;
}
.header-cta-icon {
  font-size: 1rem;
  line-height: 1;
}

/* Menu toggle button */
.header-menu-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: var(--radius-pill);
  border: 1.5px solid rgba(73, 29, 53, 0.22);
  color: var(--c-brand-navy);
  font-family: var(--font-body);
  font-size: 0.82rem;
  font-weight: 500;
  transition: border-color var(--transition-fast), background var(--transition-fast);
  cursor: pointer;
  background: transparent;
}
.header-menu-btn:hover {
  border-color: var(--c-brand-navy);
  background: rgba(73, 29, 53, 0.06);
}
.header-menu-icon {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 14px;
}
.header-menu-icon span {
  display: block;
  height: 1.5px;
  background: var(--c-brand-navy);
  border-radius: 2px;
  transition: transform 0.22s ease, opacity 0.22s ease;
}

/* On dark section: invert header colors */
.site-header.on-dark .logo-name { color: #ffffff; }
.site-header.on-dark .logo-tag  { color: rgba(255,255,255,0.55); }
.site-header.on-dark .header-phone { color: #ffffff; border-color: rgba(255,255,255,0.25); }
.site-header.on-dark .header-phone:hover { border-color: #ffffff; background: rgba(255,255,255,0.1); }
.site-header.on-dark .header-cta { background: #ffffff; color: var(--c-brand-navy); border-color: #ffffff; }
.site-header.on-dark .header-cta::before { background: #ffffff; }
.site-header.on-dark .header-cta::after  { background: rgba(73,29,53,0.12); }
.site-header.on-dark .header-menu-btn { color: #ffffff; border-color: rgba(255,255,255,0.25); }
.site-header.on-dark .header-menu-btn:hover { border-color: #ffffff; background: rgba(255,255,255,0.1); }
.site-header.on-dark .header-menu-icon span { background: #ffffff; }

/* ── Full-screen overlay menu ───────────────────────────────── */
.nav-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: var(--dark-bg, #491d35);
  color: #ffffff;
  padding: 80px var(--gutter, 32px) 48px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  transform: translateY(-100%);
  transition: transform 0.55s var(--ease-menu);
}
.nav-overlay.open {
  transform: none;
}

.nav-overlay__close {
  position: absolute;
  top: 20px;
  right: 24px;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  border: 1.5px solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.7);
  font-size: 1rem;
  cursor: pointer;
  background: transparent;
  transition: color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
}
.nav-overlay__close:hover {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.55);
  transform: rotate(90deg);
}

.nav-overlay__nav {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 640px;
}

.nav-overlay__list {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 40px;
}

.nav-overlay__link {
  display: block;
  font-family: var(--font-heading);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 400;
  color: #ffffff;
  padding: 8px 0;
  line-height: 1.2;
  letter-spacing: -0.02em;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  transition: color var(--transition-fast), padding-left var(--transition-fast);
}
@media (hover: hover) {
  .nav-overlay__link:hover {
    color: rgba(255, 255, 255, 0.65);
    padding-left: 8px;
  }
}

.nav-overlay__group {
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.nav-overlay__group-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 8px 0;
  font-family: var(--font-heading);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.2;
  color: #ffffff;
  background: transparent;
  border: none;
  cursor: pointer;
  transition: color var(--transition-fast), padding-left var(--transition-fast);
}
@media (hover: hover) {
  .nav-overlay__group-label:hover {
    color: rgba(255, 255, 255, 0.65);
    padding-left: 8px;
  }
}
.nav-overlay__chevron {
  transition: transform 0.25s ease;
  flex-shrink: 0;
  width: 20px;
  height: 20px;
}
.nav-overlay__group-label[aria-expanded="true"] .nav-overlay__chevron {
  transform: rotate(180deg);
}
.nav-overlay__sub {
  display: grid;
  grid-template-columns: 1fr;
  gap: 4px 24px;
  padding-bottom: 14px;
  overflow: hidden;
}
.nav-overlay__sub[hidden] { display: none; }
.nav-overlay__sub--cols2 { grid-template-columns: 1fr 1fr; }
.nav-overlay__sub--cols3 { grid-template-columns: 1fr 1fr 1fr; }
.nav-overlay__sub-link {
  font-family: var(--font-body);
  font-size: 0.9rem;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.65);
  padding: 4px 0;
  transition: color var(--transition-fast);
}
.nav-overlay__sub-link:hover { color: #ffffff; }

.nav-overlay__cta {
  align-self: flex-start;
  margin-bottom: 40px;
}

.nav-overlay__bottom {
  padding-top: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}
.nav-overlay__tel {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-style: italic;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: -0.01em;
  transition: color var(--transition-fast);
}
.nav-overlay__tel:hover { color: #ffffff; }

/* ── Hide phone on small screens in header ──────────────────── */
@media (max-width: 640px) {
  .header-phone { display: none; }
  .header-cta { display: none; }
  .header-inner { height: 64px; }
  .nav-overlay__sub--cols3 {
    display: block;
    columns: 2;
    column-gap: 24px;
  }
  .nav-overlay__sub--cols3 li { break-inside: avoid; }
}
</style>

<script>
const header = document.getElementById('site-header') as HTMLElement | null;
const hamburger = document.getElementById('hamburger');
const mobileMenu = document.getElementById('mobile-menu');
const mobileClose = document.getElementById('mobile-close');

// Track which sections are "dark" for header color inversion
function updateHeaderState() {
  if (!header) return;
  const scrollY = window.scrollY;

  // Check if we're currently over a dark section
  const darkSections = document.querySelectorAll('.section--dark, .hero-dark, [data-header-dark]');
  let onDark = false;
  darkSections.forEach(el => {
    const rect = el.getBoundingClientRect();
    if (rect.top <= 72 && rect.bottom > 0) onDark = true;
  });

  // Scrolled state (past hero)
  if (scrollY > 80) {
    header.classList.add('scrolled');
  } else {
    header.classList.remove('scrolled');
  }

  if (onDark) {
    header.classList.add('on-dark');
  } else {
    header.classList.remove('on-dark');
  }
}

window.addEventListener('scroll', updateHeaderState, { passive: true });
updateHeaderState();

// Menu open/close
function openMenu() {
  mobileMenu?.classList.add('open');
  mobileMenu?.setAttribute('aria-hidden', 'false');
  hamburger?.setAttribute('aria-expanded', 'true');
  document.body.style.overflow = 'hidden';
}
function closeMenu() {
  mobileMenu?.classList.remove('open');
  mobileMenu?.setAttribute('aria-hidden', 'true');
  hamburger?.setAttribute('aria-expanded', 'false');
  document.body.style.overflow = '';
  mobileMenu?.querySelectorAll('.nav-overlay__group-label').forEach(btn => {
    btn.setAttribute('aria-expanded', 'false');
    const sub = btn.nextElementSibling as HTMLElement | null;
    if (sub) sub.hidden = true;
  });
}

hamburger?.addEventListener('click', openMenu);
mobileClose?.addEventListener('click', closeMenu);
mobileMenu?.addEventListener('click', (e) => {
  if (e.target === mobileMenu) closeMenu();
});
mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

// Accordion toggles for Services / Locations
mobileMenu?.querySelectorAll('.nav-overlay__group-label').forEach(btn => {
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    const sub = btn.nextElementSibling as HTMLElement | null;
    if (sub) sub.hidden = expanded;
  });
});
</script>
