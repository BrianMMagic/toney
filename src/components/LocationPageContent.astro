---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PennTellerBadge from '../components/PennTellerBadge.astro';
import EventTypesSection from '../components/EventTypesSection.astro';
import ThreeGuarantees from '../components/ThreeGuarantees.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import VideoGrid from '../components/VideoGrid.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';
import { corporateTestimonials, type Testimonial } from '../data/testimonials';
import type { FAQ } from '../data/faqs';

export interface Props {
  pageTitle: string;
  metaDescription: string;
  canonicalUrl?: string;
  heroEyebrow: string;
  heroHeadline: string;
  heroSubheadline?: string;
  intro?: string;
  corporateHeading?: string;
  corporateBody: string;
  privateHeading?: string;
  privateBody: string;
  stageHeading?: string;
  stageBody: string;
  servingAreas: string;
  eventTypes?: string[];
  eventTypesTitle?: string;
  eventTypesTagline?: string;
  eventTypesNote?: string;
  faqs: FAQ[];
  guaranteesLabel?: string;
  testimonialsTitle?: string;
  testimonials?: Testimonial[];
  promoVideoId?: string;
  promoVideoTitle?: string;
  aboutBioParagraphs?: string[];
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const {
  pageTitle,
  metaDescription,
  canonicalUrl,
  heroEyebrow,
  heroHeadline,
  heroSubheadline,
  intro,
  corporateHeading = 'Corporate Events',
  corporateBody,
  privateHeading = 'Private Parties',
  privateBody,
  stageHeading = 'Stage Shows',
  stageBody,
  servingAreas,
  eventTypes = [
    'Holiday Parties', 'Anniversaries', 'Corporate Events', 'Cocktail Hours',
    'Weddings', 'Adult Birthdays', 'Surprise Entertainment', 'Private Parties',
  ],
  eventTypesTitle,
  eventTypesTagline,
  eventTypesNote,
  faqs,
  guaranteesLabel = 'The Key to a Truly Memorable Event',
  testimonialsTitle = "Clients Who Love Anthony's Entertainment",
  testimonials = corporateTestimonials,
  promoVideoId,
  promoVideoTitle,
  aboutBioParagraphs,
} = Astro.props;
---

<BaseLayout title={pageTitle} description={metaDescription} canonicalUrl={canonicalUrl}>
  <!-- Hero -->
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subheadline={heroSubheadline}
    ctaText="Get a Free Quote"
    ctaHref={`${base}get-a-quote`}
    ctaSecondaryText="Watch Anthony Perform"
    ctaSecondaryHref="#media"
    bgImage="images/hero/anthony-dempsey-hero.jpg"
    overlay="rgba(0,0,0,0.62)"
  />

  <!-- Penn & Teller -->
  <PennTellerBadge />

  <!-- Event Types -->
  <EventTypesSection
    title={eventTypesTitle ?? `Anthony Is The Magician ${heroEyebrow.replace(' Magician & Mentalist', '').replace(' Magician', '').replace(' Entertainer', '').trim()} Trusts For Events Like These`}
    tagline={eventTypesTagline}
    events={eventTypes}
    note={eventTypesNote}
  />

  <!-- Services -->
  <section class="section">
    <div class="container">
      <span class="section-label" data-reveal="fade-up">Services</span>
      <h2 class="section-title" data-reveal="fade-up">Make your event unforgettable with {heroEyebrow.replace(/ & Mentalist\b/i, '').trim()} Anthony Dempsey</h2>
      <div class="divider" data-reveal="fade-up"></div>
      {intro && <p class="section-sub" data-reveal="fade-up">{intro}</p>}

      <div class="loc-services-grid" data-reveal-stagger>
        <article class="loc-service-card">
          <h3 class="loc-service-heading">{corporateHeading}</h3>
          <p>{corporateBody}</p>
        </article>

        <article class="loc-service-card">
          <h3 class="loc-service-heading">{privateHeading}</h3>
          <p>{privateBody}</p>
        </article>

        <article class="loc-service-card">
          <h3 class="loc-service-heading">{stageHeading}</h3>
          <p>{stageBody}</p>
        </article>
      </div>

      <p class="serving-note" data-reveal="fade-up" set:html={servingAreas} />
    </div>
  </section>

  <!-- Guarantees -->
  <ThreeGuarantees
    label={guaranteesLabel}
    title=""
  />

  <!-- Testimonials -->
  <TestimonialsSection
    testimonials={testimonials}
    title={testimonialsTitle}
  />

  <!-- Videos -->
  <VideoGrid />

  <!-- Location promo video (page-specific featured embed) -->
  {promoVideoId && (
    <section class="section promo-video-section">
      <div class="container promo-video-container">
        {promoVideoTitle && <h2 class="promo-video-title">{promoVideoTitle}</h2>}
        <div class="promo-video-embed">
          <iframe
            src={`https://www.youtube.com/embed/${promoVideoId}`}
            title={promoVideoTitle ?? promoVideoId}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </section>
  )}

  <!-- About -->
  <AboutSection bioParagraphs={aboutBioParagraphs} />

  <!-- Contact -->
  <ContactForm
    title="Tell us about your event"
    label="Contact"
    showFullForm={true}
  />

  <!-- FAQ -->
  <FAQSection faqs={faqs} />
</BaseLayout>

<style>
.loc-services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
  margin-bottom: 40px;
}

.loc-service-card {
  background: var(--c-card-bg);
  border-radius: var(--radius-md);
  padding: 32px 28px;
  transition: background var(--transition-fast);
}
@media (hover: hover) {
  .loc-service-card:hover {
    background: var(--c-card-hover);
  }
}

.loc-service-heading {
  font-family: var(--font-heading);
  font-size: 1.2rem;
  font-weight: 400;
  color: var(--c-brand-navy);
  margin-bottom: 14px;
}

.loc-service-card p {
  font-size: 0.9rem;
  color: var(--c-dark-muted);
  line-height: 1.8;
  max-width: none;
}

.serving-note {
  font-size: 0.9rem;
  color: var(--c-dark-muted);
  text-align: center;
  font-style: italic;
}
.serving-note a {
  color: var(--c-dark-muted);
  text-decoration: underline;
  text-underline-offset: 2px;
}
.serving-note a:hover { color: var(--c-brand-navy); }

.promo-video-container { max-width: 800px; margin: 0 auto; text-align: center; }
.promo-video-title {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 400;
  color: var(--c-brand-navy);
  margin-bottom: 24px;
}
.promo-video-embed {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
}
.promo-video-embed iframe {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  border: 0;
}

@media (max-width: 900px) {
  .loc-services-grid { grid-template-columns: 1fr; }
}
</style>
