const half = Math.ceil(logos.length / 2);
const row1 = logos.slice(0, half);   // scrolls LEFT
const row2 = logos.slice(half);      // scrolls RIGHT
---

<section class="section logos-section" id="clients">
  <div class="container">
    <p class="logos-eyebrow" data-reveal="fade-up">
      Clients Who Love Anthony's Corporate Entertainment
    </p>
    <div class="divider" data-reveal="fade-up"></div>
  </div>

  <div class="logos-rows-wrap" aria-label="Corporate client logos">

    <!--
      Row 1 — scrolls LEFT
      DOM order: [originals … duplicates]
      Animation: translateX(0) → translateX(-50%)
      At loop reset: duplicate tail looks identical to original head → seamless
    -->
    <div class="logos-track logos-track--left">
      {row1.map((logo) => (
        <div class="logo-item">
          <img src={logo.src} class={`${logo.white ? 'logo--white' : ''} ${logo.tall ? 'logo--tall' : ''}`} alt="Corporate client logo" loading="lazy" width="240" height="72" />
        </div>
      ))}
      {row1.map((logo) => (
        <div class="logo-item" aria-hidden="true">
          <img src={logo.src} class={`${logo.white ? 'logo--white' : ''} ${logo.tall ? 'logo--tall' : ''}`} alt="" loading="lazy" width="240" height="72" />
        </div>
      ))}
    </div>

    <!--
      Row 2 — scrolls RIGHT
      DOM order: [duplicates … originals]  ← duplicates FIRST is the key
      Animation: translateX(-50%) → translateX(0)
      At t=0 the viewport shows originals (second half); track moves right;
      at t=end viewport shows duplicates (first half = same logos) → seamless right-scroll
    -->
    <div class="logos-track logos-track--right">
      {row2.map((logo) => (
        <div class="logo-item" aria-hidden="true">
          <img src={logo.src} class={`${logo.white ? 'logo--white' : ''} ${logo.tall ? 'logo--tall' : ''}`} alt="" loading="lazy" width="240" height="72" />
        </div>
      ))}
      {row2.map((logo) => (
        <div class="logo-item">
          <img src={logo.src} class={`${logo.white ? 'logo--white' : ''} ${logo.tall ? 'logo--tall' : ''}`} alt="Corporate client logo" loading="lazy" width="240" height="72" />
        </div>
      ))}
    </div>

  </div>
</section>

<style>
.logos-section {
  overflow: hidden;
  padding-top: 56px;
  padding-bottom: 56px;
}

.logos-eyebrow {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--c-dark-muted);
  margin-bottom: 0;
  max-width: none;
}

/* Full-bleed wrapper so fade masks span edge-to-edge */
.logos-rows-wrap {
  position: relative;
  overflow: hidden;
  margin-top: 48px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
}

.logos-track {
  display: flex;
  gap: 8px;
  width: max-content;
  will-change: transform;
}

.logos-track--left {
  animation: logos-left 40s linear infinite;
}

.logos-track--right {
  animation: logos-right 40s linear infinite;
}

.logos-track:hover {
  animation-play-state: paused;
}

/*
  scale(1.5) on the img zooms into the actual logo graphic, visually trimming
  ~33% off each side of the transparent PNG whitespace without distorting the logo.
  overflow: hidden on the container clips the scaled overflow.
  The cell is kept compact (200×64) so ~7 logos are visible per row at once.
*/
.logo-item {
  flex-shrink: 0;
  width: 200px;
  height: 64px;
  overflow: hidden;
}

.logo-item img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transform: scale(1.5);
  transform-origin: center;
}

.logo-item img.logo--white {
  filter: brightness(0);
  opacity: 0.75;
}

/* Tall logos have content near the edges — reduce zoom to prevent clipping */
.logo-item img.logo--tall {
  transform: scale(1);
}

/* Left scroll: track moves left, new logos enter from right */
@keyframes logos-left {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* Right scroll: track moves right, new logos enter from left */
@keyframes logos-right {
  from { transform: translateX(-50%); }
  to   { transform: translateX(0); }
}

@media (max-width: 640px) {
  .logo-item { width: 140px; height: 44px; }
  .logos-rows-wrap { gap: 12px; }
}
</style>
