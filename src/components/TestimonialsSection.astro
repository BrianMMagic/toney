---
import type { Testimonial } from '../data/testimonials';

export interface Props {
  testimonials: Testimonial[];
  title?: string;
  label?: string;
}

const {
  testimonials,
  title = "Clients Who Love Anthony's Entertainment",
  label = 'Testimonials',
} = Astro.props;
---

<section class="section testimonials-section section--tinted" id="testimonials">
  <img
    src="https://static.wixstatic.com/media/4426f6c0a4304f2aaab4b9eb2e05c998.jpg"
    alt=""
    class="testimonials-bg-img"
    aria-hidden="true"
    loading="lazy"
    width="1280"
    height="837"
  />
  <div class="container">
    <span class="section-label" data-reveal="fade-up">{label}</span>
    <h2 class="section-title" data-reveal="fade-up">{title}</h2>
    <div class="divider" data-reveal="fade-up"></div>

    <div class="testimonials-grid" data-reveal-stagger>
      {testimonials.map((t) => (
        <article class="testimonial-card">
          <div class="testimonial-card__stars stars" aria-label="5 stars">★★★★★</div>
          <blockquote class="testimonial-card__quote">"{t.quote}"</blockquote>
          <footer class="testimonial-card__footer">
            <div class="testimonial-card__info">
              <strong class="testimonial-card__name">{t.name}</strong>
              {t.company && <span class="testimonial-card__company">{t.company}</span>}
            </div>
          </footer>
        </article>
      ))}
    </div>

    <div class="testimonials-reviews-cta" data-reveal="fade-up">
      <a
        href="https://g.page/dallas-magician-anthony-dempsey?share"
        class="testimonials-reviews-link"
        target="_blank"
        rel="noopener noreferrer"
      >Read More Reviews</a>
    </div>
  </div>
</section>

<style>
.testimonials-section {
  position: relative;
  overflow: hidden;
}

.testimonials-bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  opacity: 0.08;
  pointer-events: none;
  z-index: 0;
}

.testimonials-section .container {
  position: relative;
  z-index: 1;
}

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.testimonial-card {
  background: #ffffff;
  border: 1px solid var(--c-card-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 28px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  transition:
    background   var(--transition-fast),
    transform    0.3s var(--ease-out-quint),
    box-shadow   0.3s var(--ease-out-quint);
}
@media (hover: hover) {
  .testimonial-card:hover {
    background: var(--c-card-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
}

.testimonial-card__stars { font-size: 0.85rem; }

.testimonial-card__quote {
  font-size: 0.9rem;
  color: var(--c-dark-base);
  line-height: 1.75;
  font-style: italic;
  flex: 1;
  max-width: none;
}

.testimonial-card__footer { margin-top: auto; }

.testimonial-card__info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.testimonial-card__name {
  font-family: var(--font-heading);
  font-size: 0.95rem;
  font-weight: 400;
  color: var(--c-brand-navy);
}
.testimonial-card__company {
  font-size: 0.78rem;
  color: var(--c-dark-muted);
  font-weight: 400;
}

@media (max-width: 960px) {
  .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .testimonials-grid { grid-template-columns: 1fr; }
}

.testimonials-reviews-cta {
  text-align: center;
  margin-top: 40px;
}

.testimonials-reviews-link {
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--c-dark-muted);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 2px;
  transition: color var(--transition-fast);
}
.testimonials-reviews-link:hover { color: var(--c-brand-navy); }
</style>
