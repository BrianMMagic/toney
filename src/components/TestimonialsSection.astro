---
import type { Testimonial } from '../data/testimonials';

export interface Props {
  testimonials: Testimonial[];
  title?: string;
  label?: string;
}

const {
  testimonials,
  title = "Clients Who Love Anthony's Entertainment",
  label = 'Testimonials',
} = Astro.props;
---

<section class="section" id="testimonials">
  <div class="container">
    <span class="section-label" data-reveal="fade-up">{label}</span>
    <h2 class="section-title" data-reveal="fade-up">{title}</h2>
    <div class="divider" data-reveal="fade-up"></div>

    <div class="testimonials-grid" data-reveal-stagger>
      {testimonials.map((t) => (
        <article class="testimonial-card">
          <div class="testimonial-card__stars stars" aria-label="5 stars">★★★★★</div>
          <blockquote class="testimonial-card__quote">"{t.quote}"</blockquote>
          <footer class="testimonial-card__footer">
            <div class="testimonial-card__info">
              <strong class="testimonial-card__name">{t.name}</strong>
              {t.company && <span class="testimonial-card__company">{t.company}</span>}
            </div>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.testimonial-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 28px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  transition: transform var(--transition-mid), box-shadow var(--transition-mid), border-color var(--transition-mid);
}
.testimonial-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-card);
  border-color: var(--color-border-light);
}

.testimonial-card__stars { font-size: 0.85rem; }

.testimonial-card__quote {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  line-height: 1.75;
  font-style: italic;
  flex: 1;
  max-width: none;
}

.testimonial-card__footer { margin-top: auto; }

.testimonial-card__info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.testimonial-card__name {
  font-family: var(--font-heading);
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-text);
}
.testimonial-card__company {
  font-size: 0.8rem;
  color: var(--color-accent);
  font-weight: 500;
}

@media (max-width: 900px) {
  .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 540px) {
  .testimonials-grid { grid-template-columns: 1fr; }
}
</style>
