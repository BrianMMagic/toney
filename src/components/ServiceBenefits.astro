---
export interface Benefit {
  title: string;
  body: string;
}

export interface Props {
  title?: string;
  label?: string;
  benefits: Benefit[];
}

const { title, label, benefits } = Astro.props;
---

<section class="section benefits-section">
  <div class="container">
    {label && <span class="section-label" data-reveal="fade-up">{label}</span>}
    {title && <h2 class="section-title" data-reveal="fade-up">{title}</h2>}
    {title && <div class="divider" data-reveal="fade-up"></div>}

    <div class="benefits-grid" data-reveal-stagger>
      {benefits.map((b) => (
        <div class="benefit-card">
          <h3 class="benefit-title">{b.title}</h3>
          <p class="benefit-body">{b.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.benefits-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.benefit-card {
  background: var(--c-card-bg);
  border: 1px solid var(--c-card-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 36px 30px;
  text-align: center;
  transition:
    background   var(--transition-fast),
    transform    0.3s var(--ease-out-quint),
    box-shadow   0.3s var(--ease-out-quint);
}
@media (hover: hover) {
  .benefit-card:hover {
    background: var(--c-card-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
}

.benefit-title {
  font-family: var(--font-heading);
  font-size: 1.2rem;
  font-weight: 400;
  color: var(--c-brand-navy);
  margin-bottom: 16px;
}

.benefit-body {
  font-size: 0.9rem;
  color: var(--c-dark-muted);
  line-height: 1.8;
  max-width: none;
}

@media (max-width: 768px) {
  .benefits-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
}
</style>
