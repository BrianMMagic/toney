---
import type { FAQ } from '../data/faqs';

export interface Props {
  faqs: FAQ[];
  title?: string;
}

const { faqs, title = 'Frequently Asked Questions' } = Astro.props;
---

<section class="section" id="faq">
  <div class="container">
    <span class="section-label" data-reveal="fade-up">FAQ</span>
    <h2 class="section-title" data-reveal="fade-up">{title}</h2>
    <div class="divider" data-reveal="fade-up"></div>

    <div class="faq-list" data-reveal="fade-up">
      {faqs.map((faq, i) => (
        <details class="faq-item" name="faq-group">
          <summary class="faq-question">
            <span>{faq.question}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
.faq-list {
  max-width: 780px;
  display: flex;
  flex-direction: column;
  gap: 1px;
  border: 1px solid var(--c-card-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.faq-item {
  background: var(--c-light-base);
  border: none;
  border-bottom: 1px solid var(--c-card-border);
  overflow: hidden;
  transition: background var(--transition-fast);
}
.faq-item:last-child { border-bottom: none; }
.faq-item[open] { background: var(--c-card-bg); }

.faq-question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 22px 24px;
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--c-dark-base);
  cursor: pointer;
  list-style: none;
  transition: color var(--transition-fast);
}
.faq-question::-webkit-details-marker { display: none; }
.faq-question:hover { color: var(--c-brand-navy); }

.faq-icon {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  font-weight: 300;
  color: var(--c-dark-muted);
  transition: transform var(--transition-fast);
  font-family: var(--font-body);
  line-height: 1;
}
.faq-item[open] .faq-icon { transform: rotate(45deg); }

.faq-answer {
  padding: 0 24px 22px;
}
.faq-answer p {
  font-size: 0.9rem;
  color: var(--c-dark-muted);
  line-height: 1.8;
  max-width: none;
}
</style>
