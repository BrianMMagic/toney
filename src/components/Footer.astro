---
import { services, locations } from '../data/nav';
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer" data-header-dark>

  <!-- Directory Section -->
  <div class="footer-dir">
    <div class="container">
      <div class="footer-grid">
        <!-- Brand Column -->
        <div class="footer-brand">
          <a href={`${base}`} class="footer-logo" aria-label="Anthony Entertains — Home">
            <span class="footer-logo-name">Anthony</span>
            <span class="footer-logo-tag">Entertains</span>
          </a>
          <p class="footer-tagline">Dallas Magician Anthony Dempsey: award-winning corporate entertainer serving Dallas–Fort Worth and nationwide.</p>
          <div class="footer-contact">
            <a href="tel:+19406540699" class="footer-contact-link">940-654-0699</a>
            <a href="mailto:Anthony@AnthonyEntertains.com" class="footer-contact-link">Anthony@AnthonyEntertains.com</a>
          </div>
        </div>


        <!-- Services Column -->
        <div class="footer-col">
          <h4 class="footer-col-title">Services</h4>
          <ul class="footer-links">
            {services.map(s => (
              <li><a href={`${base}${s.href.replace(/^\//, '')}`} class="footer-link">{s.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Locations Column -->
        <div class="footer-col footer-col--two-col">
          <h4 class="footer-col-title">Locations</h4>
          <ul class="footer-links">
            {locations.map(l => (
              <li><a href={`${base}${l.href.replace(/^\//, '')}`} class="footer-link">{l.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Quick Links Column -->
        <div class="footer-col">
          <h4 class="footer-col-title">Quick Links</h4>
          <ul class="footer-links">
            <li><a href={`${base}blog`} class="footer-link">Blog</a></li>
            <li><a href={`${base}downloadable-content`} class="footer-link">Downloadable Content</a></li>
          </ul>
        </div>

      </div>

      <div class="footer-bottom">
        <p class="footer-copy">© 2026 by Anthony Entertains</p>
        <p class="footer-service-area">Serving Dallas–Fort Worth, Arlington, Addison, Irving, Plano, McKinney, Grapevine &amp; more.</p>
      </div>
    </div>
  </div>

</footer>

<style>
.site-footer {
  background: var(--dark-bg, #491d35);
  color: var(--dark-text);
}

.footer-dir {
  padding: 40px 0 0;
}

/* Brand row — horizontal across full width */
.footer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 32px;
  padding-bottom: 32px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.footer-brand {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 32px;
  padding-bottom: 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}
.footer-logo {
  display: flex;
  flex-direction: column;
  gap: 2px;
  line-height: 1.1;
  flex-shrink: 0;
}
.footer-logo-name {
  font-family: var(--font-heading);
  font-size: 1.3rem;
  font-weight: 400;
  color: var(--dark-text);
}
.footer-logo-tag {
  font-family: var(--font-body);
  font-size: 0.58rem;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.4);
}
.footer-tagline {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.5;
  flex: 1;
  margin: 0;
}
.footer-contact {
  display: flex;
  gap: 20px;
  flex-shrink: 0;
}
.footer-contact-link {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.55);
  white-space: nowrap;
  transition: color var(--transition-fast);
}
.footer-contact-link:hover { color: var(--dark-text); }

/* Link columns */
.footer-col-title {
  font-family: var(--font-body);
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 12px;
}
.footer-links {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px 12px;
}
.footer-col:not(.footer-col--two-col) .footer-links {
  grid-template-columns: 1fr;
}
.footer-link {
  font-size: 0.82rem;
  color: rgba(255, 255, 255, 0.55);
  transition: color var(--transition-fast);
  line-height: 1.35;
}
.footer-link:hover { color: var(--dark-text); }

/* Bottom bar */
.footer-bottom {
  padding: 16px 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
}
.footer-copy { font-size: 0.75rem; color: rgba(255, 255, 255, 0.35); max-width: none; }
.footer-service-area { font-size: 0.7rem; color: rgba(255, 255, 255, 0.3); max-width: none; text-align: right; }

/* ─── Responsive ────────────────────────────────────────────── */
@media (max-width: 640px) {
  .footer-dir { padding: 28px 0 0; }

  .footer-brand {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding-bottom: 16px;
  }
  .footer-logo-name { font-size: 1.1rem; }
  .footer-tagline { font-size: 0.75rem; }
  .footer-contact { flex-direction: row; gap: 16px; flex-wrap: wrap; }
  .footer-contact-link { font-size: 0.75rem; }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 20px 16px;
    padding-bottom: 20px;
  }
  .footer-col--two-col { display: none; }
  .footer-col-title { font-size: 0.62rem; margin-bottom: 8px; }
  .footer-link { font-size: 0.78rem; }
  .footer-links { gap: 6px; }

  .footer-bottom {
    padding: 12px 0 20px;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .footer-service-area { text-align: left; }
}
</style>
